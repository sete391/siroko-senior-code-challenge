<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cart is mapped as an ORM entity for its scalar fields only.
  The $items collection is NOT mapped here — it is managed directly via
  DBAL in DoctrineCartRepository to keep the domain aggregate free of
  Doctrine Collection dependencies.
-->
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Siroko\Sales\Domain\Cart\Cart" table="carts">

        <id name="id" type="cart_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="customerId" type="customer_id" column="customer_id" nullable="true"/>

        <field name="status" type="string" length="16" column="status" nullable="false"
               enum-type="Siroko\Sales\Domain\Cart\CartStatus"/>

        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="false"/>

        <indexes>
            <index name="idx_cart_customer" columns="customer_id"/>
        </indexes>

    </entity>

</doctrine-mapping>
