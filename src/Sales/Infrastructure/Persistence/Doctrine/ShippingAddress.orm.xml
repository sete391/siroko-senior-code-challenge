<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
    xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                        https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="Siroko\Sales\Domain\ValueObject\ShippingAddress">
        <field name="firstName" type="string" column="first_name" length="255" nullable="false"/>
        <field name="lastName"  type="string" column="last_name"  length="255" nullable="false"/>
        <field name="vatNumber" type="string" column="vat_number" length="64"  nullable="false"/>
        <field name="street"    type="string" column="street"     length="255" nullable="false"/>
        <field name="city"      type="string" column="city"       length="255" nullable="false"/>
        <field name="state"     type="string" column="state"      length="255" nullable="false"/>
        <field name="zipCode"   type="string" column="zip_code"   length="16"  nullable="false"/>
        <field name="country"   type="string" column="country"    length="8"   nullable="false"/>
    </embeddable>

</doctrine-mapping>
